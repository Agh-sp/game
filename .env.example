# ─── پنل فرماندهی و ربات‌های بازی جنگ جهانی (کاملاً پایتونی) ───
# بک‌اند دیگر Node/Express نیست؛ سرور وب با aiohttp و ربات‌ها با aiogram اجرا می‌شوند.
#
# توکن‌های ربات و آیدی ادمین **در خود کد** ثبت شده‌اند
# (worldwar-game/core/config.py) و ربات‌ها بدون هیچ فایلی بالا می‌آیند.
# این فایل فقط برای بازنویسی اختیاری همان مقادیر است؛ کافی است کپی کنید:
#     cp .env.example .env
#
# توکن ربات اصلی بازی (ربات بازیکنان)
GAME_BOT_TOKEN=9201202722:AAGuSaJQw16F_ugrKXUidttYfMqI9Cz3SVE
# توکن ربات ادمین (پنل مدیریت)
ADMIN_BOT_TOKEN=9000162449:AAG-xoIDUSgE1LFWr1L3BOZjygueYuCZOfU
# آیدی عددی ادمین کل (سوپرادمین)
SUPER_ADMIN_ID=8666501866

# پورت پنل وب (پیش‌فرض 3000)
# PORT=3000
# مسیر دیتابیس (پیش‌فرض worldwar-game/wwgame.db)
# DB_PATH=worldwar-game/wwgame.db

# ─── فایربیس (اختیاری) ───
# FIREBASE_DB_URL=https://YOUR-PROJECT-ID-default-rtdb.firebaseio.com
# FIREBASE_AUTH=your-database-secret

# ─── وبهوک تلگرام (اختیاری؛ پیش‌فرض polling) ───
# WEBHOOK_MODE=1
# WEBHOOK_BASE_URL=https://your-app.example.com
# WEBHOOK_PORT=8080
# WEBHOOK_SECRET=change-me

# ─── اجرا و پینگ بیدارباش ───
# اجرای خودکار ربات‌ها هنگام بالا آمدن پنل (AUTOSTART_BOTS=0 خاموش می‌کند)
# AUTOSTART_BOTS=1
# هر چند دقیقه یک درخواست فیک به /health زده شود تا سرویس خواب نرود
# KEEPALIVE_MINUTES=10
