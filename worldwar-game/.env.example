# ─── تنظیمات بازی جنگ جهانی (کاملاً پایتونی) ───
# این فایل اختیاری است: توکن دو ربات و آیدی ادمین کل مستقیماً در
# core/config.py ثبت شده‌اند و بازی بدون هیچ فایلی اجرا می‌شود.
# برای تغییر، کافی است این فایل را به .env کپی کنید و مقدارها را عوض کنید.

# توکن ربات اصلی بازی (از @BotFather)
GAME_BOT_TOKEN=9201202722:AAGuSaJQw16F_ugrKXUidttYfMqI9Cz3SVE

# توکن ربات ادمین (ربات جداگانه از @BotFather)
ADMIN_BOT_TOKEN=9000162449:AAG-xoIDUSgE1LFWr1L3BOZjygueYuCZOfU

# آیدی عددی ادمین کل (سوپرادمین)
SUPER_ADMIN_ID=8666501866

# مسیر دیتابیس (اختیاری — پیش‌فرض کنار پروژه)
# DB_PATH=/home/user/wwgame.db

# ─── سرور وب پنل فرماندهی (پایتون/aiohttp) ───
# PORT=3000
# WEB_HOST=0.0.0.0

# ─── اتصال سرور به شکل فایربیس (اختیاری) ───
# FIREBASE_DB_URL=https://YOUR-PROJECT-ID-default-rtdb.firebaseio.com
# FIREBASE_AUTH=your-database-secret-or-token

# ─── 🔐 امنیت (به‌شدت توصیه می‌شود) ───
# کلید وبهوک: اگر خالی بماند، در اولین اجرا به‌صورت خودکار ساخته و در دیتابیس
# ذخیره می‌شود. بدون این کلید هیچ آپدیتی (حتی از خود تلگرام) پذیرفته نمی‌شود.
# WEBHOOK_SECRET=
# گذرواژهٔ پنل وب (آدرس /login). اگر خالی بماند خودکار ساخته می‌شود و از
# ربات ادمین → «🔐 امنیت» یا «🔑 گذرواژهٔ تازهٔ پنل» قابل دیدن/تغییر است.
# PANEL_PASSWORD=
# آیدی‌های اضافی برای دریافت هشدارهای امنیتی (با کاما)
# SECURITY_ALERT_TO=

# ─── وبهوک تلگرام (اختیاری) ───
# WEBHOOK_MODE=1
# WEBHOOK_BASE_URL=https://your-app.example.com
# WEBHOOK_PORT=8080

# ─── پینگ بیدارباش و اجرای خودکار ───
# KEEPALIVE_MINUTES=10
# AUTOSTART_BOTS=1
