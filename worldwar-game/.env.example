# ─── تنظیمات بازی جنگ جهانی ───
# این فایل را به .env تغییر نام دهید و مقدارها را پر کنید

# توکن ربات اصلی بازی (از @BotFather)
GAME_BOT_TOKEN=123456789:AAA-your-game-bot-token

# توکن ربات ادمین (ربات جداگانه از @BotFather)
ADMIN_BOT_TOKEN=123456789:AAA-your-admin-bot-token

# آیدی عددی ادمین اصلی (سوپرادمین) — برای گرفتن آیدی خود به @userinfobot پیام بدهید
SUPER_ADMIN_ID=123456789

# مسیر دیتابیس (اختیاری — پیش‌فرض کنار پروژه)
# DB_PATH=/home/user/wwgame.db

# ─── اتصال سرور به شکل فایربیس (اختیاری) ───
# اگر پر شود، بازی به Firebase Realtime Database شما وصل می‌شود
# (نوشتن/خواندن REST + heartbeat + همگام‌سازی خودکار)
# اگر خالی بماند، بازی در «حالت محلی» با همان امکانات اجرا می‌شود
# FIREBASE_DB_URL=https://YOUR-PROJECT-ID-default-rtdb.firebaseio.com
# FIREBASE_AUTH=your-database-secret-or-token

# ─── وبهوک تلگرام (اختیاری) ───
# حالت پیش‌فرض polling است. برای اجرا روی سرور عمومی (بدون خاموش شدن ربات) Webhook بهتر است:
#   1) WEBHOOK_MODE=1 را تنظیم کنید
#   2) WEBHOOK_BASE_URL را آدرس عمومی همین اپ بگذارید (همان Web App)
#   3) سپس: python3 run_webhook.py --set-webhook https://your-app.example.com
# یا از پنل وب: POST /api/webhook/mode {"mode":"webhook","baseUrl":"https://your-app.example.com"}
# WEBHOOK_MODE=0
# WEBHOOK_BASE_URL=https://your-app.example.com
# WEBHOOK_PORT=8080
# کلید امنیتی وبهوک (تلگرام آن را در هدر X-Telegram-Bot-Api-Secret-Token می‌فرستد)
# WEBHOOK_SECRET=change-me

# ─── پینگ بیدارباش (Keep-alive) ───
# هر چند دقیقه یک درخواست فیک به /health همین Web App زده شود تا سرویس خواب نرود
# KEEPALIVE_MINUTES=10
